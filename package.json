{
  "name": "emie-growth-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ai:test": "node scripts/test-ai-providers.mjs",
    "ai:analysis": "node scripts/run-analysis-comparison.mjs",
    "ai:app-data": "node scripts/generate-kimi-app-data.mjs",
    "ai:monthly-meeting": "node scripts/generate-monthly-meeting-insights.mjs",
    "import:reports": "node scripts/import-feishu-report-export.mjs",
    "import:scoring360": "node scripts/import-scoring360.mjs",
    "sync:lark-report": "node scripts/sync-lark-report.mjs",
    "sync:lark-report:weekly": "node scripts/run-lark-report-weekly-sync.mjs",
    "reminders:prepare": "node scripts/prepare-weekly-reminder-outbox.mjs",
    "feishu:tasks": "node scripts/create-feishu-tasks.mjs",
    "static:normalize": "node scripts/normalize-kimi-insights.mjs",
    "static:validate": "node scripts/validate-kimi-insights.mjs",
    "static:period-insights": "node scripts/build-period-kimi-insights-from-raw.mjs",
    "static:release": "npm run static:normalize && npm run static:validate && npm run static:period-insights && npm run build && node scripts/export-static-release.mjs",
    "deploy:static": "node scripts/deploy-static-release.mjs",
    "db:init": "node scripts/init-sqlite-db.mjs",
    "db:seed": "node scripts/init-sqlite-db.mjs --seed",
    "server:dev": "AUTH_MODE=mock SERVER_PORT=5174 node server/index.mjs",
    "server:start": "node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0"
  }
}
