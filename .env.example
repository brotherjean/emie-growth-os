# Copy to .env and fill server-side secrets.

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_LIGHT_MODEL=kimi-k2.5
KIMI_DEEP_MODEL=kimi-k2.6
KIMI_EMPLOYEE_MODEL=kimi-k2.6
KIMI_MANAGEMENT_MODEL=kimi-k3
KIMI_MANAGEMENT_FALLBACK_MODEL=kimi-k2.6
KIMI_MANAGEMENT_REASONING_EFFORT=high
KIMI_MONTHLY_MODEL=kimi-k3
KIMI_MONTHLY_FALLBACK_MODEL=kimi-k2.6
KIMI_MONTHLY_REASONING_EFFORT=high
ROSTER_SYNC_MIN_RATIO=0.7

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

AI_TEST_TIMEOUT_MS=60000
AI_ANALYSIS_TIMEOUT_MS=180000
AI_TEST_OUTPUT=outputs/ai-provider-comparison.md

# Web server / Feishu SSO
SERVER_PORT=5174
BASE_URL=http://localhost:5174
AUTH_MODE=feishu
SESSION_SECRET=replace-with-a-long-random-secret
WEEKLY_REPORT_DB_PATH=outputs/demo/weekly-report-os.sqlite
STATIC_DIR=dist

# Use a separate Feishu app for Weekly Report OS.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EVENT_VERIFICATION_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_COMPANY_CHAT_ID=
FEISHU_COMPANY_CHAT_NAME=
BOSS_VIEW_OPEN_IDS=
BOSS_VIEW_NAMES=

# Keep false until the task API is verified in Feishu Open Platform.
FEISHU_TASK_CREATE_ENABLED=false

# Lark report API sync. Prefer bot identity after report:task:readonly is approved for the app.
LARK_REPORT_AUTO_SYNC_ENABLED=false
LARK_REPORT_AUTO_SYNC_HOUR=8
LARK_REPORT_SYNC_IDENTITY=user
LARK_REPORT_SKILL_SCRIPT=
LARK_REPORT_AUTO_SYNC_EXEMPT=

# Collaboration 360. By default, two rounds open on the 1st and 15th of each month.
SCORING360_REMINDER_ENABLED=false
SCORING360_REMINDER_DAYS_OF_MONTH=1,15
SCORING360_REMINDER_HOUR=10
SCORING360_REMINDER_MINUTE=0
SCORING360_REMINDER_DUE_HOURS=24
SCORING360_REMINDER_FOLLOWUP_HOURS=48
SCORING360_HISTORICAL_WEIGHT=0.3
SCORING360_CURRENT_WEIGHT=0.7
SCORING360_CONFIG_MANAGER_OPEN_IDS=
SCORING360_CONFIG_MANAGER_NAMES=
SCORING360_ROSTER_EXEMPT=
